# Shared upstream settings for the /proxy/ location and its redirect follower.
resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;
resolver_timeout 5s;

proxy_http_version 1.1;
proxy_pass_request_headers off;
proxy_pass_request_body off;
proxy_set_header Content-Length "";
proxy_set_header User-Agent "OpenDataZurich-RenkuLite/1.0 (lang=python-pyodide; +https://github.com/rokroskar/opendatazurich_renku_lite)";
proxy_set_header Accept "*/*";
proxy_ssl_server_name on;
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
proxy_connect_timeout 10s;
proxy_read_timeout 120s;

proxy_buffering off;
proxy_hide_header Set-Cookie;
proxy_hide_header Content-Disposition;
proxy_hide_header Access-Control-Allow-Origin;
proxy_hide_header Access-Control-Allow-Credentials;
proxy_hide_header Access-Control-Allow-Methods;
proxy_hide_header Access-Control-Allow-Headers;
add_header Cache-Control "no-store" always;

# Follow redirects server-side (nginx caps the chain at 10 internal redirects).
proxy_intercept_errors on;
recursive_error_pages on;
error_page 301 302 303 307 308 = @odz_follow_redirect;
