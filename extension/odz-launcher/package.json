{
  "name": "odz-launcher",
  "version": "1.0.0",
  "description": "Open an OpenDataZurich starter notebook in JupyterLite from ?package_id=&resource_id=",
  "license": "MIT",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,js}"
  ],
  "scripts": {
    "build": "tsc && jupyter-builder build .",
    "clean": "rm -rf lib odz_launcher/labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/docmanager": "^4.0.0",
    "@jupyterlab/services": "^7.0.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.0",
    "typescript": "~5.5.4"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "odz_launcher/labextension"
  }
}
